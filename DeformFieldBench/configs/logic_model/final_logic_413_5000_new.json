{
  "_comment": "基于 final_logic_413：极小样本过拟合冒烟（4 条、eval=train、shuffle 关）；四阶段日程缩短便于快速验证",
  "data": {
    "split_root": "auto_output/dataset_5000/train",
    "lmdb_env_subdir": "arch4_data.lmdb",
    "sample_storage_backend": "sample_pack",
    "sample_pack_name": "sample_pack.npz",
    "train_ids_json": "auto_output/dataset_5000/train_test_split.cleaned.json",
    "purify_force_mask_on_read": true,
    "force_mask_purify_mode": "red_minus_others",
    "force_mask_single_channel": true,
    "force_mask_binary_threshold": 0.5
  },
  "model": {
    "arch": "logic_v2_dino",
    "num_views": 3,
    "num_frames": 64,
    "img_size": 224,
    "in_channels": 3,
    "dec_h": 112,
    "dec_w": 112,
    "use_uncertainty": false,
    "fusion_dim": 512,
    "fusion_heads": 8,
    "head_dropout": 0.05,
    "bottleneck_dim": 512,
    "dino_backbone_name": "dinov2_vitg14_reg",
    "dino_backbone_pretrained": true,
    "dino_backbone_source": "torchhub",
    "dino_out_dim": 1024,
    "temporal_adapter_type": "transformer",
    "temporal_adapter_layers": 2,
    "temporal_adapter_heads": 8,
    "temporal_adapter_dropout": 0.1,
    "frame_pool": "mean",
    "field_head_mode": "shared_temporal",
    "field_token_dim": 512,
    "field_base_channels": 128,
    "field_shared_channels": 96,
    "field_temporal_layers": 2,
    "field_spatial_channels": 96,
    "field_use_multiscale_spatial": true,
    "field_use_shared_task_phys": true,
    "field_use_geometry_residual": true,
    "field_sequential_stress": true,
    "use_stress_spatial_enhancer": true,
    "use_flow_spatial_enhancer": true,
    "flow_output_scale_init": 0.5,
    "flow_output_bias_init": -0.5,
    "force_out_channels": 1,
    "field_use_patch_tokens": true,
    "field_patch_dim": 256,
    "freeze_backbone": true,
    "torchhub_dir": null,
    "dino_torchhub_repo": "facebookresearch/dinov2:main",
    "dino_force_reload": false,
    "dino_trust_repo": true,
    "dino_skip_validation": true,
    "dino_hub_verbose": false,
    "dino_log_torchhub_dir": false
  },
  "train": {
    "epochs": 320,
    "batch_size": 1,
    "lr": 1e-05,
    "num_workers": 2,
    "device": "cuda",
    "max_samples": 0,
    "eval_split": "train",
    "eval_every_epochs": 9999,
    "eval_max_batches": 1,
    "eval_use_distributed_sampler": false,
    "eval_progress_every_batches": 0,
    "eval_param_scatter": false,
    "eval_param_scatter_log": false,
    "eval_video_num_samples": 0,
    "eval_train_video_num_samples": 0,
    "output_root": "logic_model/output/output_413_5000_new",
    "lambda_stress": 1,
    "lambda_flow": 1,
    "lambda_force": 2,
    "lambda_action": 0.0,
    "lambda_phys": 0.0,
    "use_action_loss": false,
    "use_phys_loss": false,
    "stage1_field_epochs": 0,
    "stage1_field_lr": 1e-05,
    "stage_flow_force_epochs": 100,
    "stage_stress_epochs": 80,
    "stage_joint_epochs": 100,
    "stage_joint_lr": 1e-05,
    "stage_flow_force_lr": 1e-05,
    "stage_stress_lr": 1e-05,
    "stage1_use_phys_loss": false,
    "lambda_stress_edge": 0.05,
    "lambda_flow_edge": 0.2,
    "edge_boost": 4.0,
    "force_bce_weight": 0.7,
    "force_dice_weight": 0.3,
    "object_mask_fg_weight": 1,
    "object_mask_bg_weight": 0,
    "object_mask_bg_black": 1,
    "overfit_no_shuffle": false,
    "debug_overfit": false,
    "use_param_groups": false,
    "torchhub_prewarm": true,
    "torchhub_require_cache": true,
    "torchhub_log_dir": false,
    "use_amp": true,
    "prefetch_factor": 2,
    "checkpoint": {
      "save_every_epochs": 40,
      "resume_from": null
    }
  }
}
