#!/bin/bash
# Build the two conda environments the FoundationStereo run needs, on a CPU node:
#   mvtracker          launcher + tracking (scripts/setup_mvtracker.sh, also downloads the MVTracker checkpoint)
#   foundation_stereo  the stereo worker  (scripts/setup_foundationstereo.sh, also downloads the ViT-L checkpoint)
# Submit from reconstruction/:  qsub scripts/crc/setup_fs_mvtracker.job
#$ -q long
#$ -pe smp 4
#$ -N fs_setup
#$ -cwd
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
set -euo pipefail
module load conda
git -C .. submodule update --init -- reconstruction/submodule/mvtracker reconstruction/submodule/FoundationStereo
MVTRACKER_TORCH_PIP=1 bash scripts/setup_mvtracker.sh
FOUNDATIONSTEREO_SKIP_FLASH_ATTN=1 bash scripts/setup_foundationstereo.sh
conda run -n mvtracker python -c "import torch; print('mvtracker torch', torch.__version__, torch.version.cuda)"
